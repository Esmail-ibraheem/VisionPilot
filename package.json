{
  "name": "tesla-viz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive 3D recreation of the Tesla driving visualization (Three.js + Vite + TypeScript)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5181 --strictPort",
    "test": "vitest run",
    "screenshot": "node scripts/screenshot.mjs",
    "nn-check": "node scripts/nn-check.mjs"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "puppeteer-core": "24.10.0",
    "typescript": "5.9.2",
    "vite": "^5.4.19",
    "vitest": "3.2.4"
  }
}
